# =============================================================================
# AdiOne — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The API validates every required key at boot and refuses to start if one is
# missing or malformed (see apps/api/src/config/env.ts).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug                      # fatal|error|warn|info|debug|trace

# ---- Database ---------------------------------------------------------------
# Local dev default matches the developer machine's Postgres instance.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/adione

# ---- Cache / ephemeral store ------------------------------------------------
# Backs OTP storage, rate limiting and the business-config cache.
#
#   REDIS=false  -> in-process `node-cache`. Runs with nothing but PostgreSQL
#                   installed. OTP and rate-limit state is LOST ON RESTART and
#                   is not shared between instances.
#   REDIS=true   -> Redis. State survives restarts and is shared across
#                   processes. REDIS_URL is then required.
REDIS=false
REDIS_URL=redis://localhost:6379

# Production requires REDIS=true. Set this only if you run a SINGLE API
# instance and accept that a restart forgets in-flight OTPs and rate limits.
ALLOW_MEMORY_CACHE_IN_PRODUCTION=false

# ---- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-min-32-chars-long-random-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Peppers the HMAC used to hash OTPs before storage. Rotating it invalidates
# all in-flight OTPs (which is safe).
OTP_PEPPER=change-me-min-32-chars-long-random-pepper-value
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- CORS -------------------------------------------------------------------
# Comma-separated allow-list. The mobile app sends no Origin header, so it is
# unaffected. NEVER use "*" together with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- OTP / SMS provider -----------------------------------------------------
# console  = dev stub, prints the OTP to the server log (blocked in production)
# msg91    = real provider (requires TRAI DLT-approved template)
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---- Payment provider -------------------------------------------------------
# mock       = dev stub, no network calls, deterministic signatures
# upi_intent = pay directly to the shop's UPI address. The customer's UPI app
#              opens via a upi:// deep link. THERE IS NO CALLBACK — nothing
#              tells this server the money arrived, so every online order must
#              be confirmed by the store in the admin panel.
# razorpay   = full gateway: automatic verification, webhooks and refunds
PAYMENT_PROVIDER=upi_intent

# Required when PAYMENT_PROVIDER=upi_intent. The shop's UPI address, and the
# name the customer sees in their UPI app.
UPI_VPA=oslokutiya@ybl
UPI_PAYEE_NAME=AdiOne

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Push notifications -----------------------------------------------------
# console = dev stub | fcm = Firebase Cloud Messaging
NOTIFICATION_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Object storage (product images) ---------------------------------------
# local = writes to apps/api/storage and serves via /static (dev only)
# s3    = any S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/static
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Search -----------------------------------------------------------------
# postgres = Postgres full-text + trigram (V1)
SEARCH_PROVIDER=postgres

# ---- Admin bootstrap --------------------------------------------------------
# Used once by `npm run db:seed` to create the first store-owner login.
# Change the password immediately after first login.
ADMIN_EMAIL=owner@adione.in
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Store Owner

# ---- Docker compose (only read by docker-compose.yml) -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=adione
